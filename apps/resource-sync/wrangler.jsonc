{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arifure-resource-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DISCORD_USERNAME": "Sphyr Development",
    "DISCORD_AVATAR_URL": ""
  },
  "secrets": {
    "required": [
      "DISCORD_WEBHOOK_LOCALIZE",
      "DISCORD_WEBHOOK_INDEX"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arifure-resources",
      "database_id": "b7222e1d-598a-45ce-8d27-198d8eb95ebd",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  }
}
